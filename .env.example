# 复制为 .env 并改成强密码：openssl rand -base64 18 或任意 20+ 位混合字符
DB_PASSWORD=change-me-to-a-long-random-password

# AI 食客共识（OpenRouter / OpenAI 兼容接口）
# AI_API_KEY 只放在服务器 .env，绝不提交仓库；不配置时摘要读缓存可用，"生成"接口返回 503，前端显示"AI 共识暂时不可用"
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# 默认 openrouter/free（路由到当日可用免费模型）；见 DEPLOY-ALIYUN.md「AI 食客共识」的当日可用型号清单
AI_MODEL=openrouter/free
# 可选调优（有默认值，通常不用改）
# AI_TIMEOUT_MS=30000
# AI_MIN_COMMENTS=3
# AI_MIN_INTERVAL_MINUTES=10
# AI_DAILY_LIMIT=100
